# .env.example — Sistema IA de Cotizaciones Tecknologistic
#
# Ninguno de estos valores es real. No rellenar con valores ficticios como
# si fueran reales (regla explícita de la sección 29 del prompt maestro).
# "PENDIENTE" marca valores que dependen de respuestas de negocio listadas
# en docs/open_questions.md — no inventarlos.

# --- Google Cloud / Gmail ---
GOOGLE_CLOUD_PROJECT=              # PENDIENTE — ver open_questions.md A.4
GOOGLE_REGION=                     # PENDIENTE
GMAIL_QUOTE_MAILBOX=               # PENDIENTE — ver open_questions.md A.4 (¿cuenta dedicada ya existe?)
GMAIL_WATCH_RENEWAL_CRON=0 0 * * * # ejemplo de cron diario — el watch() de Gmail expira cada 7 días (P0)
PUBSUB_TOPIC=
PUBSUB_SUBSCRIPTION=

# --- Base de datos ---
DATABASE_URL=

# --- Claude API ---
CLAUDE_API_KEY=
CLAUDE_MODEL_FAST=                     # PENDIENTE — modelo económico para clasificación estándar
CLAUDE_MODEL_REASONING=                # PENDIENTE — modelo de mayor razonamiento, solo por escalamiento

# --- Umbrales de confianza (defaults ya definidos en el prompt maestro v1.1) ---
CLASSIFIER_ESCALATION_THRESHOLD=0.80
CLASSIFIER_MIN_THRESHOLD=0.60
LINE_COUNT_CONFIDENCE_THRESHOLD=0.90

# --- Gobierno de costo de IA ---
AI_COST_BUDGET_PER_CASE_USD=       # PENDIENTE — ver open_questions.md A.7

# --- Odoo ---
ODOO_BASE_URL=                     # PENDIENTE — ver open_questions.md A.3
ODOO_DATABASE=                     # PENDIENTE
ODOO_API_USER=                     # PENDIENTE
ODOO_API_KEY=                      # PENDIENTE — NUNCA credencial real hasta aprobación GATE 1

# --- Privacidad / retención (LOPDP Ecuador) ---
DATA_RETENTION_DAYS=               # PENDIENTE — ver open_questions.md A.5
